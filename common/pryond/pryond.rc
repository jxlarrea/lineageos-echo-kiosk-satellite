# Amazon's wake word engine for Kiosk Satellite on /dev/socket/pryond, from
# files the user puts in /data/pryon. The image ships none of them. It loads
# nothing until an app connects, so any app may: it hears only the audio that
# app sends it.
on post-fs-data
    mkdir /data/pryon 0755 root root

service pryond /system/bin/pryond
    class main
    user nobody
    group nobody
    socket pryond stream 0666 system system
