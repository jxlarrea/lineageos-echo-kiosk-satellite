<!--
    The Echo Dot's service for Kiosk Satellite: the LED ring, the buttons,
    volume, microphone mute, Bluetooth, Wi-Fi and system updates. It runs inside
    system_server, as the empty launcher does, so it costs no process of its
    own while it stays started.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.amazon.biscuit.service"
    android:sharedUserId="android.uid.system">

    <!-- Only the system sends these, Kiosk Satellite listens. -->
    <protected-broadcast android:name="com.amazon.biscuit.service.ACTION_BUTTON" />
    <protected-broadcast android:name="com.amazon.biscuit.service.MICROPHONE_MUTE_CHANGED" />
    <protected-broadcast android:name="com.amazon.biscuit.service.VOLUME_BUTTON" />
    <protected-broadcast android:name="com.amazon.biscuit.service.SYSTEM_UPDATE_CHANGED" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- REBOOT is not asked for: the system uid holds it, and a privileged
         app that asks for it would need a privapp-permissions entry, or
         system_server refuses to start. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Biscuit Service"
        android:process="system">
        <receiver android:name=".BiscuitService$BootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- biscuit_service update check|install. Only senders holding
             REBOOT, such as root and the shell, get through. -->
        <receiver
            android:name=".SystemUpdate$Receiver"
            android:permission="android.permission.REBOOT">
            <intent-filter>
                <action android:name="com.amazon.biscuit.service.SYSTEM_UPDATE_CHECK" />
                <action android:name="com.amazon.biscuit.service.SYSTEM_UPDATE_INSTALL" />
            </intent-filter>
        </receiver>

        <!-- biscuit_service adb root on|off, adb key add and adb secure
             on|off. Only senders holding WRITE_SECURE_SETTINGS get through:
             adb, root and the system. -->
        <receiver
            android:name=".AdbReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.amazon.biscuit.service.ADB_ROOT" />
                <action android:name="com.amazon.biscuit.service.ADB_KEY" />
                <action android:name="com.amazon.biscuit.service.ADB_SECURE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".BiscuitService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.amazon.biscuit.service.IBiscuitService" />
                <action android:name="com.amazon.biscuit.service.BLUETOOTH_PAIRING_MODE" />
                <action android:name="com.amazon.biscuit.service.BLUETOOTH_OFF" />
                <action android:name="com.amazon.biscuit.service.BLUETOOTH_CONNECT" />
                <action android:name="com.amazon.biscuit.service.WIFI_ON" />
                <action android:name="com.amazon.biscuit.service.WIFI_OFF" />
                <action android:name="com.amazon.biscuit.service.WIFI_CONNECT" />
                <action android:name="com.amazon.biscuit.service.VOLUME_UP" />
                <action android:name="com.amazon.biscuit.service.VOLUME_DOWN" />
                <action android:name="com.amazon.biscuit.service.VOLUME_SET" />
                <action android:name="com.amazon.biscuit.service.COUNTDOWN_PROGRESS" />
                <action android:name="com.amazon.biscuit.service.COUNTDOWN_CLEAR" />
                <action android:name="com.amazon.biscuit.service.MICROPHONE_MUTE_ON" />
                <action android:name="com.amazon.biscuit.service.MICROPHONE_MUTE_OFF" />
                <action android:name="com.amazon.biscuit.service.MICROPHONE_MUTE_TOGGLE" />
            </intent-filter>
        </service>
    </application>
</manifest>
