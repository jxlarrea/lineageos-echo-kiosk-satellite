From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jxlarrea <jx@jxl.me>
Date: Fri, 30 Oct 2026 05:27:03 -0500
Subject: [PATCH] input: focaltech: Wake the screen on a double tap

The Echo Show 8 (1st gen) put its FocalTech touch chip to sleep, cut its
power and disabled its interrupt when the screen turned off, so a tap
could never wake it.

With double_tap on, keep the chip powered and scanning instead and send
KEY_WAKEUP when two touches start within 400 ms. No other touch is
reported while the screen is off. fts_ts_resume() resets the chip on the
way back, as before.

double_tap (/sys/module/focaltech_core/parameters/double_tap) turns it
off, which brings back the sleep and power off.
---
 .../mediatek/FT5526/focaltech_core.c          | 60 +++++++++++++++++++
 1 file changed, 60 insertions(+)

diff --git a/drivers/input/touchscreen/mediatek/FT5526/focaltech_core.c b/drivers/input/touchscreen/mediatek/FT5526/focaltech_core.c
index 672b4ee7..f8d9aaf6 100644
--- a/drivers/input/touchscreen/mediatek/FT5526/focaltech_core.c
+++ b/drivers/input/touchscreen/mediatek/FT5526/focaltech_core.c
@@ -686,11 +686,58 @@ static int fts_read_parse_touchdata(struct fts_ts_data *data)
     return 0;
 }
 
+/*
+ * Double tap to wake. The touch chip keeps scanning while the screen is off,
+ * so two touches that start within FTS_DOUBLE_TAP_MS of each other wake it.
+ * No other touch reaches Android while the screen is off.
+ */
+#define FTS_DOUBLE_TAP_MS   400
+static bool double_tap = true;
+module_param(double_tap, bool, 0644);
+MODULE_PARM_DESC(double_tap, "Wake the screen on a double tap while it is off");
+static bool dt2w_down;
+static unsigned long dt2w_last_down;
+
+static void fts_double_tap(struct fts_ts_data *data)
+{
+    u8 point_num;
+
+    if (fts_read_touchdata(data))
+        return;
+
+    point_num = data->point_buf[FTS_TOUCH_POINT_NUM] & 0x0F;
+    if (point_num == 0 || point_num > data->pdata->max_touch_number) {
+        dt2w_down = false;
+        return;
+    }
+    if (dt2w_down)
+        return;
+    dt2w_down = true;
+
+    if (dt2w_last_down && time_before(jiffies,
+            dt2w_last_down + msecs_to_jiffies(FTS_DOUBLE_TAP_MS))) {
+        dt2w_last_down = 0;
+        FTS_INFO("Double tap, waking the screen");
+        input_report_key(data->input_dev, KEY_WAKEUP, 1);
+        input_sync(data->input_dev);
+        input_report_key(data->input_dev, KEY_WAKEUP, 0);
+        input_sync(data->input_dev);
+        return;
+    }
+    dt2w_last_down = jiffies;
+}
+
 static void fts_irq_read_report(void)
 {
     int ret = 0;
     struct fts_ts_data *ts_data = fts_data;
 
+    if (ts_data->suspended) {
+        if (double_tap)
+            fts_double_tap(ts_data);
+        return;
+    }
+
 #if FTS_ESDCHECK_EN
     fts_esdcheck_set_intr(1);
 #endif
@@ -757,6 +804,7 @@ static int fts_input_init(struct fts_ts_data *ts_data)
     input_dev->dev.parent = ts_data->dev;
 
     input_set_drvdata(input_dev, ts_data);
+    input_set_capability(input_dev, EV_KEY, KEY_WAKEUP);
 
     __set_bit(EV_SYN, input_dev->evbit);
     __set_bit(EV_ABS, input_dev->evbit);
@@ -1591,6 +1639,18 @@ static int fts_ts_suspend(struct device *dev)
     }
 #endif
 
+    /*
+     * For double tap to wake the TP stays powered and scanning instead of
+     * going to sleep mode. fts_ts_resume() resets it either way.
+     */
+    if (double_tap) {
+        dt2w_down = false;
+        dt2w_last_down = 0;
+        ts_data->suspended = true;
+        FTS_FUNC_EXIT();
+        return 0;
+    }
+
     fts_irq_disable();
 
     /* TP enter sleep mode */
-- 
2.47.3

