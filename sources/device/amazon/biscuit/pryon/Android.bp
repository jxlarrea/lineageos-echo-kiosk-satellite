// Amazon's wake word engine as a service for Kiosk Satellite.
cc_binary {
    name: "biscuit-pryond",
    srcs: ["biscuit-pryond.cpp"],
    cflags: ["-Wall", "-Werror"],
    shared_libs: [
        "libcutils",
        "libdl",
    ],
}
