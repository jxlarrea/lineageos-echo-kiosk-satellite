# Services the Echo Dot never uses, replaced by definitions that do nothing.
# init keeps the first definition of a service unless a later one says
# override, so these win wherever init reads them from.

# Camera: the Dot has none.
service cameraserver /system/bin/true
    override
    oneshot
    disabled

# drmserver stays even though nothing on the Dot plays protected content:
# MediaProvider waits for it when it starts. Without it the media provider
# never answered and Android killed and restarted it every 80 seconds.

# GPU statistics: the Dot has no GPU, and clients only check whether the
# service is there.
service gpu /system/bin/true
    override
    oneshot
    disabled

# Media metrics: persist.media.metrics.enabled=0 tells every client to skip
# it, so none of them waits for the service.
service mediametrics /system/bin/true
    override
    oneshot
    disabled

# Metrics, incident reports, storage statistics, identity credentials and
# heap tracing: nothing on a Dot uses them, and each daemon costs memory.
# Stopping these and others on LineageOS 18.1 freed about 10 MB with Kiosk
# Satellite running. HALs the VINTF manifest declares are left alone: a
# declared HAL that never starts blocks every client that asks for it.
service statsd /system/bin/true
    override
    oneshot
    disabled

service incidentd /system/bin/true
    override
    oneshot
    disabled

service storaged /system/bin/true
    override
    oneshot
    disabled

service credstore /system/bin/true
    override
    oneshot
    disabled

service traced_perf /system/bin/true
    override
    oneshot
    disabled

# Kiosk Satellite Edition: installs Kiosk Satellite on first boot and keeps
# its grants in place (ks-install.sh). setprop persist.biscuit.ks_install 0
# turns it off.
service ks_install /system/bin/ks-install
    user root
    group root
    disabled
    oneshot

on property:sys.boot_completed=1
    start ks_install
