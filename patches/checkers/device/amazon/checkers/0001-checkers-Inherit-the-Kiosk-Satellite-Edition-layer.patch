checkers: Inherit the Kiosk Satellite Edition layer

lineage_checkers inherits the layer every Echo shares, the layer every
Echo Show shares and the checkers additions, which stage-tree.sh copies
into the tree. The model gets (KS), so Home Assistant and the router show
that the Show runs this image.

--- a/lineage_checkers.mk
+++ b/lineage_checkers.mk
@@ -12,9 +12,16 @@ $(call inherit-product, device/amazon/checkers/device.mk)
 # Inherit some common LineageOS stuff.
 $(call inherit-product, vendor/lineage/config/common_full_tablet_wifionly.mk)
 
+# Inherit the Kiosk Satellite Edition layer.
+$(call inherit-product, vendor/kiosk-satellite/config/common.mk)
+$(call inherit-product, vendor/kiosk-satellite/config/show.mk)
+$(call inherit-product, device/kiosk-satellite/checkers/device.mk)
+
 PRODUCT_NAME := lineage_checkers
 PRODUCT_DEVICE := checkers
 PRODUCT_MANUFACTURER := Amzn
 PRODUCT_BRAND := google
-PRODUCT_MODEL := Echo Show 5
+# Kiosk Satellite Edition: (KS) shows in Home Assistant and on the router
+# that the Show runs this image.
+PRODUCT_MODEL := Echo Show 5 1st Gen (KS)
 PRODUCT_CHARACTERISTICS := tablet,nosdcard
