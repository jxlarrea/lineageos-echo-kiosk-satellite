crown: Inherit the Kiosk Satellite Edition layer

lineage_crown inherits the layer every Echo shares, the layer every Echo
Show shares and the crown additions, which stage-tree.sh copies into the
tree. The model gets (KS), so Home Assistant and the router show that the
Show runs this image.

diff --git a/lineage_crown.mk b/lineage_crown.mk
index d782bf0..26220d0 100644
--- a/lineage_crown.mk
+++ b/lineage_crown.mk
@@ -12,9 +12,16 @@ $(call inherit-product, device/amazon/crown/device.mk)
 # Inherit some common LineageOS stuff.
 $(call inherit-product, vendor/lineage/config/common_full_tablet_wifionly.mk)
 
+# Inherit the Kiosk Satellite Edition layer.
+$(call inherit-product, vendor/kiosk-satellite/config/common.mk)
+$(call inherit-product, vendor/kiosk-satellite/config/show.mk)
+$(call inherit-product, device/kiosk-satellite/crown/device.mk)
+
 PRODUCT_NAME := lineage_crown
 PRODUCT_DEVICE := crown
 PRODUCT_MANUFACTURER := Amzn
 PRODUCT_BRAND := google
-PRODUCT_MODEL := Echo Show 8
+# Kiosk Satellite Edition: (KS) shows in Home Assistant and on the router
+# that the Show runs this image.
+PRODUCT_MODEL := Echo Show 8 1st Gen (KS)
 PRODUCT_CHARACTERISTICS := tablet,nosdcard
