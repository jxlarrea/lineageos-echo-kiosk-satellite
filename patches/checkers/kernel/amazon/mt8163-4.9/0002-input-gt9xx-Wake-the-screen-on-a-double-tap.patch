From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jxlarrea <jx@jxl.me>
Date: Fri, 30 Oct 2026 05:27:02 -0500
Subject: [PATCH] input: gt9xx: Wake the screen on a double tap

The Echo Show 5 (2nd gen) keeps its GT911 powered and scanning while the
screen is off (CONFIG_GTP9XX_SLEEP_MODE), but the work function returned
early for every interrupt while suspended. It dropped the touch and never
turned the interrupt back on, so nothing reached the driver until the
screen came back on.

While suspended, read the touch status and send KEY_WAKEUP when two
touches start within 400 ms. No other touch is reported while the screen
is off. The GT911's own doze mode cannot do this: its firmware raises a
steady stream of interrupts in doze and never reports a gesture.

double_tap (/sys/module/gt9xx/parameters/double_tap) turns it off.
---
 .../input/touchscreen/mediatek/gt9xx/gt9xx.c  | 47 ++++++++++++++++++-
 1 file changed, 46 insertions(+), 1 deletion(-)

diff --git a/drivers/input/touchscreen/mediatek/gt9xx/gt9xx.c b/drivers/input/touchscreen/mediatek/gt9xx/gt9xx.c
index ade49ff3..0bc3ac48 100644
--- a/drivers/input/touchscreen/mediatek/gt9xx/gt9xx.c
+++ b/drivers/input/touchscreen/mediatek/gt9xx/gt9xx.c
@@ -111,6 +111,41 @@ static enum DOZE_T doze_status = DOZE_DISABLED;
 static s8 gtp_enter_doze(struct goodix_ts_data *ts);
 #endif
 
+/*
+ * Double tap to wake. The touch chip keeps scanning while the screen is off,
+ * so two touches that start within GTP_DOUBLE_TAP_MS of each other wake it.
+ * No other touch reaches Android while the screen is off.
+ */
+#define GTP_DOUBLE_TAP_MS	400
+static bool double_tap = true;
+module_param(double_tap, bool, 0644);
+MODULE_PARM_DESC(double_tap, "Wake the screen on a double tap while it is off");
+static bool dt2w_down;
+static unsigned long dt2w_last_down;
+
+static void gtp_double_tap(struct goodix_ts_data *ts, u8 touch_num)
+{
+	if (!touch_num) {
+		dt2w_down = false;
+		return;
+	}
+	if (dt2w_down)
+		return;
+	dt2w_down = true;
+
+	if (dt2w_last_down && time_before(jiffies,
+			dt2w_last_down + msecs_to_jiffies(GTP_DOUBLE_TAP_MS))) {
+		dt2w_last_down = 0;
+		GTP_INFO("Double tap, waking the screen.");
+		input_report_key(ts->input_dev, KEY_WAKEUP, 1);
+		input_sync(ts->input_dev);
+		input_report_key(ts->input_dev, KEY_WAKEUP, 0);
+		input_sync(ts->input_dev);
+		return;
+	}
+	dt2w_last_down = jiffies;
+}
+
 static ssize_t gtp_suspend_store(struct device *dev,
 		struct device_attribute *attr, const char *buf, size_t count);
 static DEVICE_ATTR(suspend, 0200, NULL, gtp_suspend_store);
@@ -566,7 +601,7 @@ static void goodix_ts_work_func(struct work_struct *work)
 	GTP_DEBUG_FUNC();
 	ts = container_of(work, struct goodix_ts_data, work);
 
-	if (ts->enter_update || ts->gtp_is_suspend)
+	if (ts->enter_update)
 		return;
 
 #if GTP_GESTURE_WAKEUP
@@ -679,6 +714,13 @@ static void goodix_ts_work_func(struct work_struct *work)
 	}
 
 	finger = point_data[GTP_ADDR_LENGTH];
+
+	if (ts->gtp_is_suspend) {
+		if (double_tap && (finger & 0x80))
+			gtp_double_tap(ts, finger & 0x0f);
+		goto exit_work_func;
+	}
+
 #if GTP_COMPATIBLE_MODE
 
 	/*  GT9XXF reques event */
@@ -2084,6 +2126,7 @@ static s8 gtp_request_input_dev(struct goodix_ts_data *ts)
 	input_set_capability(ts->input_dev,
 	EV_KEY, KEY_POWER);
 #endif
+	input_set_capability(ts->input_dev, EV_KEY, KEY_WAKEUP);
 #if GTP_CHANGE_X2Y
 	GTP_SWAP(ts->abs_x_max, ts->abs_y_max);
 #endif
@@ -3003,6 +3046,8 @@ static void goodix_ts_suspend(struct goodix_ts_data *ts)
 
 	GTP_INFO("System suspend.");
 
+	dt2w_down = false;
+	dt2w_last_down = 0;
 	ts->gtp_is_suspend = 1;
 #if GTP_ESD_PROTECT
 #if GTP_SUSPEND_PWROFF
-- 
2.47.3

