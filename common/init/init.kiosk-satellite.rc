# Kiosk Satellite Edition: installs Kiosk Satellite on first boot and keeps
# its grants in place (ks-install.sh). setprop persist.echo.ks_install 0
# turns it off.
service echo_ks_install /system/bin/echo-ks-install
    user root
    group root
    disabled
    oneshot

on property:sys.boot_completed=1
    start echo_ks_install

# adb over Wi-Fi, which echo_service adb wifi on|off switches. mt8163-common
# turns it on at every boot, so this runs once Android has booted and again
# whenever the setting changes. Port 0 leaves adb on USB only.
on property:sys.boot_completed=1 && property:persist.echo.adb_wifi=0
    setprop service.adb.tcp.port 0
    restart adbd

on property:sys.boot_completed=1 && property:persist.echo.adb_wifi=1
    setprop service.adb.tcp.port 5555
    restart adbd

# Double tap to wake, which Android's Double tap to wake setting turns on and
# off. EchoService copies the setting to persist.echo.double_tap_wake. Each
# Show has one of these touch drivers (patches/<device>/kernel).
on property:persist.echo.double_tap_wake=*
    write /sys/module/gt9xx/parameters/double_tap ${persist.echo.double_tap_wake}
    write /sys/module/focaltech_core/parameters/double_tap ${persist.echo.double_tap_wake}

# Half the kernel's emergency reserve mt8163-common sets (16 MB), which it
# sizes for the Echos with 2 GB. The low and high watermarks follow it, and
# at 8 MB a 1 GB Show has about 30 MB more available. The Dot goes down to
# 4 MB, but a Show still needs room for its display and camera. Runs on
# boot, after mt8163-common's post-fs-data value.
on boot
    write /proc/sys/vm/min_free_kbytes 8192

# EchoService turns privacy on through the privacy chip's enable file, for
# echo_service privacy on and the privacy timeout (Privacy.java). The driver
# only ever turns privacy on through it. Each Show has one of the two.
on boot
    chown system system /sys/devices/platform/gpio-privacy/enable
    chown system system /sys/devices/platform/amazon-gating/enable


# Services a kiosk never uses, replaced by definitions that do nothing, as
# on the Echo Dot. init keeps the first definition of a service unless a
# later one says override. Metrics, incident reports, storage statistics,
# identity credentials and heap tracing: nothing on a Show reads them.
# persist.media.metrics.enabled=0 tells every media metrics client to skip
# the service.
service statsd /system/bin/true
    override
    oneshot
    disabled

service incidentd /system/bin/true
    override
    oneshot
    disabled

service storaged /system/bin/true
    override
    oneshot
    disabled

service credstore /system/bin/true
    override
    oneshot
    disabled

service traced_perf /system/bin/true
    override
    oneshot
    disabled

service mediametrics /system/bin/true
    override
    oneshot
    disabled
