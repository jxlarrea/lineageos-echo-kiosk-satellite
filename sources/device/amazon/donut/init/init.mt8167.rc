import /vendor/etc/init/hw/init.mt8167.usb.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug

on init
    chmod 0666 /dev/ion
    chmod 0660 /dev/rfkill
    write /proc/sys/net/core/wmem_max 8388608
    write /proc/sys/net/core/rmem_max 8388608

    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/background/cpus 0
    write /dev/cpuset/system-background/cpus 0-2
    write /dev/cpuset/restricted/cpus 0-1
    write /dev/cpuset/top-app/cpus 0-3

on fs
    mount_all /vendor/etc/fstab.mt8167 --early

on late-fs
    mount_all /vendor/etc/fstab.mt8167 --late

on post-fs-data
    setrlimit 8 -1 -1

    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/bluedroid 0771 bluetooth bluetooth
    exec - root bluetooth -- /vendor/bin/donut-btmac

    # The MT7668's Wi-Fi and Bluetooth drivers. They take their firmware
    # from /vendor/firmware (firmware_class.path on the kernel command line).
    insmod /system/lib/modules/wlan_mt76x8_sdio_prealloc.ko
    insmod /system/lib/modules/wlan_mt76x8_sdio.ko
    insmod /system/lib/modules/btmtksdio.ko

on boot
    # adb over the network, as on the other Echos.
    setprop service.adb.tcp.port 5555

# Light ring. biscuit-ledd stops the kernel's boot animation once Android is
# up and takes commands on /dev/socket/biscuit-ledd.
service biscuit-ledd /system/bin/biscuit-ledd
    class main
    user root
    group system
    socket biscuit-ledd stream 0660 system system
    disabled

on property:sys.boot_completed=1
    start biscuit-ledd

# Rooted adb on debuggable builds. LineageOS keeps the switch in
# /data/adbroot/enabled, set from Settings, which nobody can reach on the Dot.
on post-fs-data && property:ro.debuggable=1
    mkdir /data/adbroot 0700 root root encryption=Require
    write /data/adbroot/enabled 1

# KSM, as on the Echo Dot (2nd gen): bionic marks every private anonymous
# mapping mergeable, so the same pages in different processes, the zygote's
# children above all, are kept once. 100 pages every 500 ms.
on boot
    write /sys/kernel/mm/ksm/pages_to_scan 100
    write /sys/kernel/mm/ksm/sleep_millisecs 500
    write /sys/kernel/mm/ksm/run 1
