<resources>
    <!-- A Bluetooth speaker: phones play to it and it can play to others. -->
    <bool name="profile_supported_a2dp">true</bool>
    <bool name="profile_supported_a2dp_sink">true</bool>
    <bool name="profile_supported_avrcp_controller">true</bool>
    <bool name="profile_supported_avrcp_target">true</bool>
    <bool name="a2dp_sink_automatically_request_audio_focus">true</bool>

    <!-- Nothing for calls, contacts, messages, tethering or file transfer:
         the Dot has no modem, no contacts provider and no screen to accept
