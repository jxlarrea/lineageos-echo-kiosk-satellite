wpa_supplicant: Let a board build it into system

WPA_SUPPLICANT_IN_SYSTEM builds wpa_supplicant and its HIDL library as
system modules, without the vendor init script and manifest fragment. The
Echo Show 8 (2nd gen) runs on Fire OS's vendor partition, whose own
wpa_supplicant links a HIDL library Android's VNDK 28 does not have.

diff --git a/wpa_supplicant/Android.mk b/wpa_supplicant/Android.mk
index ed6c57d..4928433 100644
--- a/wpa_supplicant/Android.mk
+++ b/wpa_supplicant/Android.mk
@@ -1727,7 +1727,9 @@ include $(BUILD_EXECUTABLE)
 ########################
 include $(CLEAR_VARS)
 LOCAL_MODULE := wpa_supplicant
+ifneq ($(WPA_SUPPLICANT_IN_SYSTEM),true)
 LOCAL_PROPRIETARY_MODULE := true
+endif
 LOCAL_MODULE_RELATIVE_PATH := hw
 ifdef CONFIG_DRIVER_CUSTOM
 LOCAL_STATIC_LIBRARIES := libCustomWifi
@@ -1768,11 +1770,13 @@ LOCAL_SHARED_LIBRARIES += android.hardware.wifi.supplicant@1.2
 LOCAL_SHARED_LIBRARIES += android.hardware.wifi.supplicant@1.3
 LOCAL_SHARED_LIBRARIES += libhidlbase libutils libbase
 LOCAL_STATIC_LIBRARIES += libwpa_hidl
+ifneq ($(WPA_SUPPLICANT_IN_SYSTEM),true)
 LOCAL_VINTF_FRAGMENTS := hidl/$(HIDL_INTERFACE_VERSION)/manifest.xml
 ifeq ($(WIFI_HIDL_UNIFIED_SUPPLICANT_SERVICE_RC_ENTRY), true)
 LOCAL_INIT_RC=hidl/$(HIDL_INTERFACE_VERSION)/android.hardware.wifi.supplicant-service.rc
 endif
 endif
+endif
 include $(BUILD_EXECUTABLE)
 
 ########################
@@ -1816,7 +1820,9 @@ ifeq ($(WPA_SUPPLICANT_USE_HIDL), y)
 ########################
 include $(CLEAR_VARS)
 LOCAL_MODULE := libwpa_hidl
+ifneq ($(WPA_SUPPLICANT_IN_SYSTEM),true)
 LOCAL_VENDOR_MODULE := true
+endif
 LOCAL_CPPFLAGS := $(L_CPPFLAGS)
 LOCAL_CFLAGS := $(L_CFLAGS)
 LOCAL_C_INCLUDES := $(INCLUDES)
