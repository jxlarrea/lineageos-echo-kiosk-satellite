// The Echo Shows' service for setting them up from adb and for system
// updates (echo-service/), and its command.
android_app {
    name: "EchoService",
    srcs: [
        "echo-service/src/**/*.java",
        "echo-service/src/**/*.aidl",
    ],
    manifest: "echo-service/AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    // What a kiosk never uses, which Android then leaves out of the image.
    // The Shows keep SystemUI, WebView, Settings, the keyboard, the
    // launcher, the file picker and captive portal sign-in: Kiosk
    // Satellite's home screen setting falls back to the launcher if the
    // kiosk cannot start, and Settings is the way back from there.
    overrides: [
        // echo_service sets up what the setup wizard would ask for, so a
        // Show boots straight to Kiosk Satellite.
        "LineageSetupWizard",

        // System updates come from EchoService, and nothing is backed up.
        "Seedvault",
        "SharedStorageBackup",
        "Updater",

        // Telephony: the Shows have no modem, and the phone process and its
        // providers only cost memory.
        "BlockedNumberProvider",
        "MmsService",
        "SimAppDialog",
        "Telecom",
        "TeleService",
        "TelephonyProvider",

        // Apps a kiosk does not open. Kiosk Satellite uses the camera
        // itself.
        "AudioFX",
        "BookmarkProvider",
        "BuiltInPrintService",
        "CalendarProvider",
        "Camera2",
        "Contacts",
        "ContactsProvider",
        "DeskClock",
        "EasterEgg",
        "Eleven",
        "Etar",
        "ExactCalculator",
        "Gallery2",
        "Jelly",
        "LocalContactsBackup",
        "PrintRecommendationService",
        "PrintSpooler",
        "Profiles",
        "QuickAccessWallet",
        "Recorder",
        "SecureElement",
    ],
}

sh_binary {
    name: "echo_service",
    src: "echo-service/echo_service",
}

// Installs Kiosk Satellite on first boot and keeps its grants (init/).
sh_binary {
    name: "echo-ks-install",
    src: "init/ks-install.sh",
}

prebuilt_etc {
    name: "init.kiosk-satellite.rc",
    src: "init/init.kiosk-satellite.rc",
    sub_dir: "init",
}

