diff --git a/audio/hal/legacy/audio_stream.cpp b/audio/hal/legacy/audio_stream.cpp
index 6b6bb37..ab86c00 100644
--- a/audio/hal/legacy/audio_stream.cpp
+++ b/audio/hal/legacy/audio_stream.cpp
@@ -7,6 +7,7 @@
 
 #include <errno.h>
 #include <malloc.h>
+#include <math.h>
 #include <pthread.h>
 #include <stdint.h>
 #include <stdlib.h>
@@ -188,6 +189,18 @@ static ssize_t stream_in_ext_read(struct audio_stream_in* stream, void* buffer,
         asp_send_command(ASP_CMD_SET_VOIP_MODE, 0);
         stream_in_ext->capture_started = true;
     }
+    if (ret > 0 && stream_in_ext->gain != 1.0f &&
+        stream->common.get_format(&stream->common) == AUDIO_FORMAT_PCM_16_BIT) {
+        /* Above three quarters of full scale the gain bends into a soft
+         * limit instead of clipping. */
+        int16_t* samples = static_cast<int16_t*>(buffer);
+        for (ssize_t i = 0; i < ret / 2; i++) {
+            float v = samples[i] * stream_in_ext->gain / 32768.f;
+            float a = fabsf(v);
+            if (a > 0.75f) v = copysignf(0.75f + 0.25f * tanhf((a - 0.75f) / 0.25f), v);
+            samples[i] = (int16_t)(v * 32767.f);
+        }
+    }
     if (ret > 0)
         stream_in_ext->frames_read += ret / audio_stream_in_frame_size(stream);
 
