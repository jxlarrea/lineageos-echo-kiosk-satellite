# The partitions the update tools write, from the TWRP the Dot's unlock
# installs. TWRP links current-system and current-boot to the slot it booted
# on, which an updater script's add_slot_suffix() cannot be trusted to match.
# System is the root on this Dot, so the tools want it at /.

#<src>                        <mnt_point> <type> <mnt_flags and options> <fs_mgr_flags>
/dev/block/current-system     /           ext4   ro                      wait
/dev/block/current-boot       /boot       emmc   defaults                defaults
/dev/block/platform/bootdevice/by-name/userdata /data  ext4 noatime,nosuid,nodev wait
/dev/block/platform/bootdevice/by-name/cache    /cache ext4 noatime,nosuid,nodev wait
