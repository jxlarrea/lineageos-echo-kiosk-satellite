audio: Let a device send mic captures through Amazon's ASR pipeline

ro.vendor.audio.asr_capture=1 hands plain MIC and CAMCORDER captures to
Amazon's ASR pipeline, the far-field front end Amazon's own wake word listens
to: its echo canceller, beamformer and residual echo suppression over every
microphone and the speaker reference. ro.vendor.audio.asr_capture_gain_db
raises its output, which comes out about 25 dB quieter than a plain capture,
bending into a soft limit above three quarters of full scale.

On an Echo Show 8 (1st gen) with vsWakeWord, 40 held-out voices from 2.5 m
at 50% volume: 14 of 40 wake words over music instead of 5 with the Kiosk
Satellite Edition's own echo canceller on microphone 0, and 17 of 40 over
the assistant's voice instead of 11, as many as in a quiet room.

diff --git a/audio/hal/asp.cpp b/audio/hal/asp.cpp
index c068ec3..a88f482 100644
--- a/audio/hal/asp.cpp
+++ b/audio/hal/asp.cpp
@@ -7,8 +7,11 @@
 #include <errno.h>
 #include <string.h>
 
+#include <math.h>
+
 #include <atomic>
 
+#include <cutils/properties.h>
 #include <cutils/str_parms.h>
 
 #include "asp.h"
@@ -51,11 +54,31 @@ void asp_set_parameters(const char* kv_pairs) {
     str_parms_destroy(parms);
 }
 
+bool asr_capture() {
+    static const bool on = property_get_bool("ro.vendor.audio.asr_capture", false);
+    return on;
+}
+
+float asr_capture_gain() {
+    static const float gain =
+            powf(10.f, property_get_int32("ro.vendor.audio.asr_capture_gain_db", 0) / 20.f);
+    return gain;
+}
+
 /*
  * The HAL only runs Amazon's capture processing for voice sources, there is
  * no pipeline for plain mic captures. Use the voice one, it has AGC and NR.
+ *
+ * ro.vendor.audio.asr_capture=1 sends plain mic captures through Amazon's
+ * ASR pipeline instead, the far-field front end Amazon's own wake word
+ * listens to: its echo canceller, beamformer and residual echo suppression
+ * over every microphone and the speaker reference.
  */
 audio_source_t remap_input_source(audio_source_t source) {
+    if (asr_capture() && get_asp_command() &&
+        (source == AUDIO_SOURCE_MIC || source == AUDIO_SOURCE_CAMCORDER))
+        return AUDIO_SOURCE_VOICE_RECOGNITION;
+
     if (!noise_suppression || !get_asp_command())
         return source;
 
