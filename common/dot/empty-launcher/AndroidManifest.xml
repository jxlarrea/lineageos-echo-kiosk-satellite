<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.amazon.biscuit.emptylauncher"
    android:sharedUserId="android.uid.system">

    <!-- Runs inside system_server, as SettingsProvider does. In a process of
         its own it cost about 12 MB to draw one black window. Drawn in
         software: with hardware acceleration HWUI loads SwiftShader. -->
    <application
        android:process="system"
        android:hardwareAccelerated="false"
        android:label="Echo Dot"
        android:theme="@style/AppTheme">
        <activity
            android:name=".EmptyLauncherActivity"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
