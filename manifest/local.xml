<?xml version="1.0" encoding="UTF-8"?>
<!--
  The amazon-oss MT8163 projects on top of LineageOS 18.1, for every device
  this repo builds. It follows amazon-oss/local_manifests (lineage-18.1) with
  only the devices we build, plus the Linaro toolchain. scripts/sync.sh
  resolves it into lock.xml on the first sync, and every later sync uses the
  lock. A project added here later goes into lock.xml by hand, pinned to a
  commit.
-->
<manifest>
  <remote name="amazon-oss"
          fetch="https://github.com/amazon-oss"
          revision="refs/heads/lineage-18.1" />

  <project path="device/amazon/crown"         name="android_device_amazon_crown"         remote="amazon-oss" />
  <project path="device/amazon/checkers"      name="android_device_amazon_checkers"      remote="amazon-oss" />
  <project path="device/amazon/mt8163-common" name="android_device_amazon_mt8163-common" remote="amazon-oss" />

  <project path="kernel/amazon/mt8163-4.9"    name="android_kernel_amazon_mt8163"        remote="amazon-oss" />
  <project path="kernel/amazon/mt66xx-common" name="android_kernel_amazon_mt66xx-common" remote="amazon-oss" />
  <project path="kernel/amazon/mt66xx-bt"     name="android_kernel_amazon_mt66xx-bt"     remote="amazon-oss" />
  <project path="kernel/amazon/mt66xx-wifi"   name="android_kernel_amazon_mt66xx-wifi"   remote="amazon-oss" />
  <project path="kernel/amazon/mt76x8-bt"     name="android_kernel_amazon_mt76x8-bt"     remote="amazon-oss" />
  <project path="kernel/amazon/mt76x8-wifi"   name="android_kernel_amazon_mt76x8-wifi"   remote="amazon-oss" />

  <project path="hardware/amazon"          name="android_hardware_amazon"          remote="amazon-oss" />
  <project path="hardware/mediatek/mt66xx" name="android_hardware_mediatek_mt66xx" remote="amazon-oss" />
  <project path="hardware/mediatek/mt76xx" name="android_hardware_mediatek_mt76xx" remote="amazon-oss" />

  <project path="vendor/amazon/crown"         name="android_vendor_amazon_crown"         remote="amazon-oss" />
  <project path="vendor/amazon/checkers"      name="android_vendor_amazon_checkers"      remote="amazon-oss" />
  <project path="vendor/amazon/mt8163-common" name="android_vendor_amazon_mt8163-common" remote="amazon-oss" />

  <!-- The LineageOS patches every amazon-oss build needs. stage-tree.sh applies them. -->
  <project path="patches" name="patches" remote="amazon-oss" />

  <!--
    BoardConfigCommon.mk builds the kernel with prebuilts/linaro, which no
    published manifest provides. The tree's aarch64-linux-android-4.9 is too
    old for this kernel, which needs GCC 5.1 or newer. This one is Linaro
    GCC 6.3.1. The branch does not matter for a toolchain.
  -->
  <remote name="mt8163" fetch="https://github.com/mt8163" />
  <project path="prebuilts/linaro" name="android_prebuilts_linaro"
           remote="mt8163" revision="refs/heads/lineage-21.0"
           clone-depth="1" />
</manifest>
