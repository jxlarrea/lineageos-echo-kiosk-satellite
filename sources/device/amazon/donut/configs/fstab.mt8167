# The bootloader has the kernel mount the booted slot's system partition as
# the root, so it is not listed here.
/dev/block/platform/soc/11120000.mmc/by-name/userdata   /data       ext4   noatime,nosuid,nodev,noauto_da_alloc,errors=remount-ro latemount,wait,check,formattable,reservedsize=128m
/dev/block/platform/soc/11120000.mmc/by-name/cache      /cache      ext4   noatime,nosuid,nodev,noauto_da_alloc                   wait,check,formattable

/dev/block/platform/soc/11120000.mmc/by-name/boot       /boot       emmc   defaults                                               slotselect
/dev/block/platform/soc/11120000.mmc/by-name/misc       /misc       emmc   defaults                                               defaults

/dev/block/zram0                                        /swap_zram0 swap   defaults                                               wait,zramsize=50%,max_comp_streams=4
