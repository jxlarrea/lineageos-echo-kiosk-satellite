keystore: Make the Wi-Fi HIDL libraries available to system

A wpa_supplicant built into system links libkeystore-wifi-hidl and
libkeystore-engine-wifi-hidl, which were vendor only.

diff --git a/keystore-engine/Android.bp b/keystore-engine/Android.bp
index 6512c66..81dae4e 100644
--- a/keystore-engine/Android.bp
+++ b/keystore-engine/Android.bp
@@ -67,5 +67,5 @@ cc_library_shared {
         "libutils",
     ],
 
-    vendor: true,
+    vendor_available: true,
 }
diff --git a/keystore/Android.bp b/keystore/Android.bp
index 45b721b..1d8f644 100644
--- a/keystore/Android.bp
+++ b/keystore/Android.bp
@@ -253,7 +253,7 @@ cc_library_shared {
 
     export_include_dirs: ["include"],
 
-    vendor: true,
+    vendor_available: true,
 }
 
 // Library for unit tests
