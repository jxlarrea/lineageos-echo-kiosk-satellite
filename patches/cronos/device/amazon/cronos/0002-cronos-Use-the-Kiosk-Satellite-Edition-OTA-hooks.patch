cronos: Use the Kiosk Satellite Edition OTA hooks

They keep mt8163-common's by-name links and add the release the package
holds, which EchoService checks before it installs a system update.

--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -42,3 +42,7 @@ include device/amazon/mt8163-common/BoardConfigCommon.mk
 
 # Inherit the proprietary files
 include vendor/amazon/cronos/BoardConfigVendor.mk
+
+# Kiosk Satellite Edition: mt8163-common's OTA hooks plus the release the
+# package holds, for system updates.
+TARGET_RELEASETOOLS_EXTENSIONS := vendor/kiosk-satellite/releasetools
