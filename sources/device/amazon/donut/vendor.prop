# Display: the Dot has no screen and no GPU driver. SurfaceFlinger composes
# with SwiftShader into buffers from ashmem for a display nobody sees.
ro.hardware.egl=swiftshader
ro.hardware.gralloc=default
ro.hardware.hwcomposer=donut
ro.config.no_gpu=true
debug.sf.nobootanimation=1

# Wi-Fi
wifi.interface=wlan0
ro.boot.wificountrycode=US

# Bluetooth audio goes through the audio HAL's A2DP module.
persist.bluetooth.bluetooth_audio_hal.disabled=true

# Where donut-btmac puts the Dot's Bluetooth address for the HAL.
ro.bt.bdaddr_path=/data/vendor/bluedroid/macbt

# The Bluetooth vendor library does not look for an rfkill switch, as on
# the Echo Show 8 (1st gen). The driver powers the MT7668 itself.
ro.vendor.rfkilldisabled=1
