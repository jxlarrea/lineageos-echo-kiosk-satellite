# Display: the Dot has no screen and no GPU driver. SurfaceFlinger composes
# with SwiftShader into buffers from ashmem for a display nobody sees.
ro.hardware.egl=swiftshader
ro.hardware.gralloc=default
ro.hardware.hwcomposer=donut
ro.config.no_gpu=true
debug.sf.nobootanimation=1

# Wi-Fi
wifi.interface=wlan0
