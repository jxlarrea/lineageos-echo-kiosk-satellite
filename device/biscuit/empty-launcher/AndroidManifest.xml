<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.amazon.biscuit.emptylauncher">

    <!-- Drawn in software: with hardware acceleration HWUI loads SwiftShader,
         7.4 MB of private memory measured on 18.1, to draw one black window. -->
    <application
        android:hardwareAccelerated="false"
        android:label="Echo Dot"
        android:theme="@style/AppTheme">
        <activity
            android:name=".EmptyLauncherActivity"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
